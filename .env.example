# Copy to .env for local development. Never commit real secrets.
ENVIRONMENT=dev
DATABASE_URL=sqlite+pysqlite:///./ticketpilot.db
# Postgres (docker compose):
# DATABASE_URL=postgresql+psycopg://ticketpilot:ticketpilot@localhost:5432/ticketpilot
AUTO_CREATE_TABLES=true

# Dev-only header identity. Production requires oidc (adapter not implemented -> startup refuses).
IDENTITY_ADAPTER=dev_headers
# mock | http (http adapter not implemented -> production startup refuses).
REFUND_PROVIDER=mock
# Exposes /docs, /redoc, /openapi.json. Production requires false.
DOCS_ENABLED=true

APPROVAL_TTL_MINUTES=30
REFUND_APPROVAL_THRESHOLD_CENTS=0
REFUND_POLICY_VERSION=refund-policy-v3
REFUND_WINDOW_DAYS=30
REFUND_MAX_AMOUNT_CENTS=5000000
POLICY_MAX_RESULTS=6
POLICY_MIN_SCORE=0.01
# Row cap for the controlled text-to-SQL path.
ANALYTICS_MAX_LIMIT=200
# P3-b: prefetch + Python pre-aggregation next to controlled SQL.
# The row count is a scoped COUNT, not a model estimate. Set ENABLED=false to
# go back to the P3-a SQL-only behaviour.
ANALYTICS_PREFETCH_ENABLED=true
ANALYTICS_PREFETCH_MAX_ROWS=200
ANALYTICS_SNAPSHOT_TTL_SECONDS=900
# Model expression for the prefetch path. It is never called in AGENT_MODE=rules.
ANALYTICS_NARRATION_ENABLED=true

# success | fail | timeout_before | timeout_after | unknown
MOCK_REFUND_MODE=success
MOCK_REFUND_DELAY_SECONDS=0

# rules = offline deterministic routing (default)
# pydantic_ai = bounded LLM fallback. The only verified path is a local
# OpenAI-compatible server (LM Studio):
#   AGENT_MODEL=openai:qwen/qwen3-8b
#   OPENAI_BASE_URL=http://127.0.0.1:1234/v1
#   OPENAI_API_KEY=lmstudio
# The default below is the hosted Anthropic path; it needs ANTHROPIC_API_KEY
# and has NOT been verified in this repo.
AGENT_MODE=rules
AGENT_MODEL=anthropic:claude-sonnet-4-5
AGENT_REQUEST_LIMIT=2
AGENT_TIMEOUT_SECONDS=20
# Wrap the model in PydanticAI's OpenTelemetry instrumentation: one `chat <model>`
# CLIENT span per model request, so a validation retry shows up as a second
# span. opentelemetry-api ships with pydantic-ai-slim; the global provider is a
# no-op until an operator installs an SDK/exporter, so this costs nothing when
# nobody is listening. Set false to disable.
AGENT_OTEL_INSTRUMENT=true

# Retrieval. One chain ships: BM25 fused with a dense channel by per-channel
# z-scores (alpha=0.3), optionally reranked. The dense half needs the endpoint
# below; without it the chain runs sparse only, which is the offline/dev path.
# Production refuses to start without the endpoint.
RETRIEVAL_RERANK_ENABLED=false
# How far each channel looks before the cut. The corpus is 15 chunks and the
# fused list saturates at 20; deeper only costs latency.
RETRIEVAL_CANDIDATE_POOL=20
RETRIEVAL_DENSE_MIN_SCORE=0
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
# EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=10
RERANK_URL=
RERANK_MODEL=
# A local, no-cloud endpoint that works with the bge-reranker contract is
# Infinity in Docker:
#   docker run -d --name ticketpilot-reranker -p 127.0.0.1:7998:7997 \
#     -v <model-cache>:/app/.cache:ro michaelf34/infinity:latest-cpu v2 \
#     --engine torch --model-id /app/.cache/model \
#     --served-model-name text-embedding-bge-reranker-v2-m3 --port 7997 --batch-size 4
# then RERANK_URL=http://127.0.0.1:7998/rerank and
#      RERANK_MODEL=text-embedding-bge-reranker-v2-m3
# LM Studio does not expose /v1/rerank, so it cannot serve this channel.
# RERANK_API_KEY=
RERANK_TIMEOUT_SECONDS=5
RERANK_TOP_N=20
RERANK_FAILURE_THRESHOLD=3
RERANK_COOLDOWN_SECONDS=30

# Query rewrite at the retrieval entry point. It only changes the *retrieval*
# text: the customer's message, the intent route, the slot extraction and the
# reply keep the original words. Three additive rules, all local and
# deterministic (no model, no network, no clock):
#   numbers   append the Arabic form of a Chinese number plus its quantifier
#             (三十天 -> also 30天, 一百二十九元 -> also 129元), the Chinese form
#             stays so 七天无理由 still matches its section title;
#   sections  append 1 active section title of the current ACTIVE policies;
#   synonyms  append the other members of a policy term group (只追加, 不替换).
# Turning the master switch off restores the pre-rewrite ranking bit for bit.
RETRIEVAL_QUERY_REWRITE_ENABLED=true
RETRIEVAL_QUERY_REWRITE_NUMBERS=true
RETRIEVAL_QUERY_REWRITE_SYNONYMS=true
RETRIEVAL_QUERY_REWRITE_SECTIONS=true
# Section hints per query (口径上限 2, 默认 1).
RETRIEVAL_QUERY_REWRITE_MAX_SECTION_HINTS=1
# Appended terms per query, original excluded (口径上限 8). Numbers are kept
# first, then sections, then synonyms.
RETRIEVAL_QUERY_REWRITE_MAX_EXPANSIONS=8

# Handoff / escalation. Triggers live in app/agent/escalation.yaml; these are the numbers.
ESCALATION_FRUSTRATION_ROUNDS=2
# Clarification budget: ask once, ask again with the customer's own order
# candidates, hand over only when the third turn still has no order.
# Set it back to 2 to restore "the second clarification is a handover".
ESCALATION_CLARIFICATION_ROUNDS=3
HANDOFF_AFTER_FAILED_ATTEMPTS=2
# "No evidence" is judged on the scale the score was measured on: a BM25 score
# in the tens, a cosine score in 0..1, and a reranker score in 0..1 cannot
# share one number. A fused row reports the channel score it came from, so the
# fused z-score never needs a line of its own. The verdict scale (the action
# layer's own 0-or-1 answer) has no setting on purpose.
ESCALATION_NO_EVIDENCE_SCORE=5.0
ESCALATION_NO_EVIDENCE_SCORE_DENSE=0.35
ESCALATION_NO_EVIDENCE_SCORE_RERANK=0.35
SESSION_IDLE_MINUTES=20
HANDOFF_CLAIM_TIMEOUT_SECONDS=120
HANDOFF_REPEAT_WINDOW_HOURS=24
ABANDON_IDLE_MINUTES=30
HANDOFF_DIGEST_MAX_CHARS=400

# T2 guards: observational input scan, output grounding, and transport caps.
SECURITY_EVENTS_ENABLED=true
RATE_LIMIT_ENABLED=true
# Per-process token buckets; every worker keeps its own budget.
RATE_LIMIT_TENANT_PER_MINUTE=600
RATE_LIMIT_IP_PER_MINUTE=300
# memory = the process-local token bucket (default; N workers = N times the
# budget). redis = a shared per-minute counter (INCR + EXPIRE) so the limit is
# one fact across workers; the window is coarse, so a tenant can spend two
# windows back to back at a minute edge. Selecting redis without REDIS_URL (or
# without the optional `redis` package) refuses startup. A Redis outage falls
# back to the local bucket, never to "no limit".
# RATE_LIMIT_STORE=redis
# REDIS_URL=redis://127.0.0.1:6379/0
REDIS_TIMEOUT_SECONDS=0.5
# Non-multipart request body cap (bytes).
REQUEST_MAX_BYTES=262144
# Multipart body cap for the whole request, not per file (bytes).
ATTACHMENT_MAX_BYTES=5242880

# T4 channels. Web reuses the dev header identity; email and IM are opt-in and
# need a webhook secret plus a sender-to-customer map, or production refuses to
# start. Maps are JSON objects of "sender": "tenant:user"; the sender never
# chooses a tenant from the request body.
CHANNEL_WEB_ENABLED=true
CHANNEL_EMAIL_ENABLED=false
CHANNEL_IM_ENABLED=false
# HMAC-SHA256 over "<timestamp>.<raw body>"; header X-Channel-Signature: sha256=<hex>.
CHANNEL_WEBHOOK_MAX_SKEW_SECONDS=300
# A delivery claim older than this can be taken over by another worker.
CHANNEL_DELIVERY_CLAIM_TIMEOUT_SECONDS=120
CHANNEL_EMAIL_SLA_HOURS=24
# CHANNEL_EMAIL_SECRET=
# CHANNEL_IM_SECRET=
# CHANNEL_EMAIL_IDENTITY_MAP={"alice@example.com": "demo:alice"}
# CHANNEL_IM_IDENTITY_MAP={"zhangsan": "demo:alice"}

# T7-4 outbound transport for proactive notices. The address a notice is sent
# to is looked up by reversing the maps above (server config), never taken from
# the queued payload or the profile. "none" refuses every send, so a notice
# stays CONFIRMED and never claims SENT; "local_file" appends the rendered
# notice as one JSON line to a file — a demonstration sink, "sent" only means
# it left this application. Production refuses anything but "none".
CHANNEL_OUTBOUND_TRANSPORT=none
# CHANNEL_OUTBOUND_DROP_FILE=.tmp/proactive-outbox.jsonl

# T5 memory and proactive service. No secrets and no switch: a profile is only
# created by the customer's own PUT, proactive rules seed with
# requires_confirmation=true, and the customer's consent is read per profile.

# T9: whether the answer path reads that profile at all. The reader is
# app/agent/personalization.py and it only applies server-owned templates (a
# greeting with the customer's chosen name, one follow-up chip for a product
# the catalog recognises, a shorter chip list when tone is concise, card
# order). Set false and every reply goes back to the pre-T9 wording; the
# profile itself is untouched either way.
MEMORY_PERSONALIZATION_ENABLED=true

# P8 intent candidate shortlisting. Before the model is asked, the server lists
# the catalog rows it has evidence for (rule reading, cues, real slots,
# conversation context, order state) and the model may only pick among those or
# answer NONE. Set the switch false and the model face goes back to naming one
# of the six literals, trace fields included. HUMAN_HANDOFF and UNKNOWN are
# always offered and never take a slot in the cap.
INTENT_CANDIDATES_ENABLED=true
INTENT_CANDIDATES_MAX=6

# F-1 counter-question. A legal-but-unadopted model reading buys at most one
# intent-confirming question per conversation (`.qoder/rules/clarify-counter-question.md`
# §10). Set false and the behavior goes back to the pre-F-1 one byte for byte:
# the question gate never asks the model, a rejected reroute reading falls back
# to the generic UNKNOWN menu, and no counter_question.asked audit event is
# written.
COUNTER_QUESTION_ENABLED=true
