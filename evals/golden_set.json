{
  "version": 2,
  "description": "离线 Golden Set：40 条任务路径用例，覆盖任务运行时支持的 6 个意图（ORDER_QUERY / LOGISTICS_QUERY / POLICY_QA / TICKET_CREATE / REFUND_REQUEST / UNKNOWN）的正常、边界与失败形态。只读路径的 12 意图覆盖见 evals/support_set.json。每条用例都带 expected_outcome 与 expected_tool，并断言 trace 中的工具名、参数、降级步骤与回执字段来源。",
  "coverage": {
    "task_intents": [
      "ORDER_QUERY",
      "LOGISTICS_QUERY",
      "POLICY_QA",
      "TICKET_CREATE",
      "REFUND_REQUEST",
      "UNKNOWN"
    ],
    "support_only_intents": [
      "HUMAN_HANDOFF",
      "REFUND_STATUS",
      "REFUND_ELIGIBILITY",
      "DELIVERY_ISSUE",
      "SELF_ANALYTICS",
      "PRODUCT_QUERY"
    ],
    "note": "UNKNOWN 没有 normal 形态：无法归类的问题本身就是失败形态。12 个意图的并集是评测集的契约。"
  },
  "cases": [
    {
      "id": "order-query-own",
      "kind": "normal",
      "tenant": "demo",
      "user": "alice",
      "request": "帮我查询订单 ORD-DEMO-1001",
      "expected_intent": "ORDER_QUERY",
      "expected_outcome": "VERIFIED_SUCCESS",
      "expected_tool": "get_order",
      "expect": {
        "http_status": 201,
        "task_status": "SUCCEEDED",
        "contains": ["ORD-DEMO-1001", "可退余额"],
        "not_contains": ["ORD-OTHER-3001"],
        "tool_params": {"get_order": {"order_id": "ORD-DEMO-1001"}},
        "receipt_from": "get_order",
        "no_degradation": true
      }
    },
    {
      "id": "order-query-zero-balance",
      "kind": "boundary",
      "tenant": "demo",
      "user": "alice",
      "request": "帮我查询订单 ORD-EVAL-4014",
